# .env.example
# ------------
# Environment variables for PhishingHunter Elite production deployment
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!

# ==============================================================================
# DATABASE
# ==============================================================================

# Choose ONE of the following database options:

# OPTION 1: MongoDB Atlas (Recommended for Cloud) ⭐
# Get your connection string from: https://cloud.mongodb.com/
# Free tier: 512MB storage, perfect for getting started
# Format: mongodb+srv://username:password@cluster.mongodb.net/phishinghunter
MONGODB_URI=

# Optional: Custom MongoDB database name (default: phishinghunter)
MONGODB_DB_NAME=phishinghunter

# OPTION 2: PostgreSQL (Self-hosted or managed)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://phishuser:changeme_in_production@postgres:5432/phishinghunter

# PostgreSQL password (also used in docker-compose.yml)
POSTGRES_PASSWORD=changeme_in_production

# OPTION 3: SQLite (Local file - Development only)
# No configuration needed, uses local file: data/phishinghunter.db
# Automatically used if neither MONGODB_URI nor DATABASE_URL is set

# ==============================================================================
# REDIS
# ==============================================================================

# Redis connection string
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# FLASK
# ==============================================================================

# Flask environment (development|production)
FLASK_ENV=production

# Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=please_change_this_to_a_random_string_in_production

# PhishingHunter secret (used for internal signing)
PHISHINGHUNTER_SECRET=also_change_this_to_a_random_string

# ==============================================================================
# ADMIN PANEL (Phase 9)
# ==============================================================================

# Admin username
ADMIN_USERNAME=admin

# Admin password (plaintext - only for development, see below for production)
ADMIN_PASSWORD=changeme

# Admin password hash (SHA256) - USE THIS IN PRODUCTION instead of ADMIN_PASSWORD
# Generate with: python admin_auth.py your_secure_password
# Example hash below is for "changeme" - DO NOT USE IN PRODUCTION!
# ADMIN_PASSWORD_HASH=8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92

# ==============================================================================
# API KEYS (Optional - improves detection accuracy)
# ==============================================================================

# Google Safe Browsing API v4
# Get free key: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3
# Get free key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# ==============================================================================
# GUNICORN (Production WSGI Server)
# ==============================================================================

# Number of worker processes (recommended: 2-4 x CPU cores)
WORKERS=4

# Request timeout in seconds
TIMEOUT=120

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level (DEBUG|INFO|WARNING|ERROR|CRITICAL)
LOG_LEVEL=INFO

# ==============================================================================
# SECURITY (Production)
# ==============================================================================

# Allowed hosts (comma-separated, e.g., "yourdomain.com,www.yourdomain.com")
# ALLOWED_HOSTS=

# CORS origins (if needed for API access)
# CORS_ORIGINS=

# ==============================================================================
# NGINX / HTTPS
# ==============================================================================

# Your domain name (for SSL certificate)
# DOMAIN=yourdomain.com

# Let's Encrypt email (for SSL certificate renewal notifications)
# LETSENCRYPT_EMAIL=admin@yourdomain.com

# ==============================================================================
# OPTIONAL: ML Model Configuration
# ==============================================================================

# ML model path (default: ml/model.joblib)
# ML_MODEL_PATH=ml/model.joblib

# ==============================================================================
# OPTIONAL: Visual Similarity Configuration
# ==============================================================================

# Enable/disable visual similarity checks (true|false)
# VISUAL_SIMILARITY_ENABLED=true

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. Generate secure random secrets:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. For production, ALWAYS change:
#    - POSTGRES_PASSWORD
#    - SECRET_KEY
#    - PHISHINGHUNTER_SECRET
#
# 3. Optional API keys significantly improve detection:
#    - Google Safe Browsing: Free tier available
#    - VirusTotal: Free tier available (4 req/min)
#
# 4. Database URL format:
#    - MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/dbname
#    - PostgreSQL: postgresql://user:pass@host:port/dbname
#    - SQLite (dev): Automatic, uses data/phishinghunter.db
#
#    Priority: MONGODB_URI > DATABASE_URL > SQLite (local file)
#
# 5. Redis URL format:
#    - redis://host:port/db
#    - redis://host:port/db?password=pass
#
